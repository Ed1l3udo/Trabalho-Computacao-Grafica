#!/usr/bin/env bash
set -euo pipefail

CXX="${CXX:-g++}"
CC="${CC:-gcc}"
MKTEMP="$(command -v mktemp || printf '%s' /usr/bin/mktemp)"
RM="$(command -v rm || printf '%s' /usr/bin/rm)"
RAYLIB_BUILD_DIR="$("$MKTEMP" -d "${TMPDIR:-/tmp}/raylib-build.XXXXXX")"
trap '"$RM" -rf "$RAYLIB_BUILD_DIR"' EXIT

"$CXX" -std=c++17 -Wall -Wextra -Wpedantic \
  -I./src/utils -I./src/objetos src/main.cpp -o app.exe \
  -static-libgcc -static-libstdc++

RAYLIB_SOURCES=(rcore rshapes rtextures rtext rmodels utils raudio rglfw)
RAYLIB_OBJECTS=()
for source in "${RAYLIB_SOURCES[@]}"; do
  "$CC" -std=c99 -Wall -D_GNU_SOURCE \
    -DPLATFORM_DESKTOP_GLFW -DGRAPHICS_API_OPENGL_33 \
    -Wno-missing-braces -Werror=pointer-arith -fno-strict-aliasing \
    -Iexternal/raylib/src \
    -Iexternal/raylib/src/external/glfw/include \
    -Iexternal/raylib/src/external/glfw/deps/mingw \
    -c "external/raylib/src/${source}.c" \
    -o "$RAYLIB_BUILD_DIR/${source}.o"
  RAYLIB_OBJECTS+=("$RAYLIB_BUILD_DIR/${source}.o")
done

"$CXX" -std=c++17 -Wall -Wextra -Wpedantic -O2 \
  src/main_interativo.cpp "${RAYLIB_OBJECTS[@]}" \
  -Iexternal/raylib/src \
  -Iexternal/raylib/src/external/glfw/include \
  -Iexternal/raylib/src/external/glfw/deps/mingw \
  -Isrc -Isrc/utils -Isrc/objetos \
  -o app_interativo.exe \
  -static-libgcc -static-libstdc++ \
  -lopengl32 -lgdi32 -lwinmm -lole32 -luser32 -lshell32
